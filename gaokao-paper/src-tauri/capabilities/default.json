{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "组卷应用所需的最小权限：对话框、文件读写、打开外部文件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "opener:default",
    "opener:allow-open-path"
  ]
}
